# Signalpost Agent Configuration

# General Application Settings
APP_ENV=production
LOG_LEVEL=INFO

# Storage Configuration
DATABASE_PATH=data/signalpost.db
PROFILES_EXPORT_PATH=data/company_profiles.jsonl
CACHE_DIR=data/cache

# Official Norwegian Registry API Endpoints (Permitted Open Public Sources)
BRREG_ENHETER_URL=https://data.brreg.no/enhetsregisteret/api/enheter
BRREG_REGNSKAP_URL=https://data.brreg.no/regnskapsregisteret/regnskap

# Outbound Request & Rate Limits (Strictly Enforced)
MAX_OUTBOUND_REQUESTS=2000
MAX_EXECUTION_MINUTES=45
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_RPS=5.0

# Optional LLM Configuration (Zero-cost heuristic fallback is used when unset)
# Set your API key if you want LLM-powered summarization of unstructured web text
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
DECLARED_MAX_API_COST=10.00
